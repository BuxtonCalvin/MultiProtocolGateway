{
  "transport": "modbus_rtu",
  "send_holding_register": true,
  "send_input_register": false,

  "alarm_codes": {
    "0": "no alarm",
    "1": "alarm"
  },

  "relay_state_codes": {
    "0": "open",
    "1": "closed"
  },

  "alarm_reason_codes": {
    "b1":  "low SOC",
