    "0": "L123",
    "1": "L1",
    "2": "L2",
    "3": "L3"
  },

  "mppt1_dcst_codes": {
    "1": "Off (OFF)",
    "2": "Sleeping (SLEEPING)",
    "3": "Starting (STARTING)",
    "4": "MPPT",
    "5": "Throttled (THROTTLED)",
    "7": "Fault (FAULT)"
  },

  "nameplate_dertyp_codes": {
    "4": "PV",
    "82": "PV_STOR"
  }
