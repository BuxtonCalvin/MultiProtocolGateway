MultiProtocolGateway or App/
├── protocol_gateway.py               ← wire webserver start here
├── config.cfg
├── protocols/
│   └── [protocol_group]/
│       ├── eg4_18kpv_holding.csv
│       ├── eg4_18kpv_input.csv
│       └── eg4_18kpv.json
└── classes/
    └── WebServer/
        ├── main.py                   ← FastAPI app, startup, uvicorn launcher
        ├── database.py               ← SQLAlchemy engine, Base, session factory
        ├── models.py                 ← ORM models: Setting, ProtocolRegister, DirtyState
        ├── scanner.py                ← scans config.cfg + transport files → populates DB
        ├── config_writer.py          ← commit logic: DB → config.cfg + mask/screen files
        ├── diff_engine.py            ← compares DB staging vs config.cfg on disk
        ├── file_watcher.py           ← watchdog-based file change detector
        │
        ├── services/
        │   ├── device_service.py     ← SCRAPER/BRIDGE classification, device CRUD
        │   ├── protocol_service.py   ← CSV/JSON read, override file management
        │   ├── analysis_service.py   ← wraps gateway's analyze_protocol()
        │   └── backup_service.py     ← versioned config.cfg backups + rollback
        │
        ├── routers/
        │   ├── devices.py            ← /api/devices/*
        │   ├── protocols.py          ← /api/protocols/*
        │   ├── pages.py              ← /api/pages/*
        │   ├── commit.py             ← /api/commit
        │   └── analysis.py           ← /api/analyze (SSE)
        │
        ├── templates/
