  },

  "control_wmaxlim_ena_codes": {
    "0": "DISABLED",
    "1": "ENABLED"
  },

  "inverter_st_codes": {
    "1": "Off (OFF)",
    "2": "Sleeping (SLEEPING)",
    "3": "Starting (STARTING)",
    "4": "MPPT",
    "5": "Throttled (THROTTLED)",
    "6": "Shutting down (SHUTTING_DOWN)",
    "7": "Fault (FAULT)",
    "8": "Standby (STANDBY)"
  },

