[general]
read_mode = sequential

[logging]
log_dir = logs
log_file = MPG.log
level = DEBUG
rotation = weekly
when = W0
interval = 1
backup_count = 4
max_bytes = 104857600
console = true

[messages]
enabled = true
default_title = MPG Notification
pushover_enabled = true
pushover_api_token = azs5ghrj7cu6qte9hfrkkhm5dd
pushover_user_key = uh6193ey3y7cfony594juw9qt5x
telegram_enabled = true
telegram_bot_token = 7051560669:AAHZolX0WOAEF7J2ANJq0ezPIs3s2El0
telegram_chat_ids = -1002111140370


[transport.Inverter_read]
log_level = DEBUG
transport = modbus_tcp
protocol_version = eg4_18kpv
host = 10.17.2.65
port = 502
read_interval = 15
device_location = home
write_enabled = false
device_manufacturer = EG4
device_model = 18KPV
device_name = EG4 18kpv1
device_serial_number = 4066670074
bridge = transport.json_output

[transport.json_output]
# JSON output transport - writes data to stdout
transport = json_out
pretty_print = true
include_timestamp = true
use_utc_timestamp = false
include_device_info = true
output_file = /json_out/output.json
save_file = true
