    "0": "standby",
    "1": "running",
    "2": "fault",
    "3": "shutdown"
  },
  "output_type_codes": {
    "0": "L/N",
    "1": "L1/L2/L3",
    "2": "L1/L2/L3/N",
    "3": "L1/L2/N"
  },
